# =============================================================================
# ZoneOps local dev environment
# Copy to .env at the repo root. Loaded by every app via packages/config.
# =============================================================================

# ---- Postgres -----------------------------------------------------------------
# When running apps on the host against docker-compose Postgres:
DATABASE_URL=postgres://zoneops:zoneops@localhost:5432/zoneops

# When running an app *inside* the docker network, use service name instead:
# DATABASE_URL=postgres://zoneops:zoneops@postgres:5432/zoneops

# ---- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- API ----------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of bearer tokens that grant access to one org each.
# Format: token=org_slug. For MVP we hardcode a couple.
# Generate real tokens with: openssl rand -hex 24
API_TOKENS=dev-token-acme=acme,dev-token-northwind=northwind

# ---- Worker -------------------------------------------------------------------
WORKER_CONSUMER_GROUP=zoneops-workers
WORKER_CONSUMER_NAME=worker-1
WORKER_BATCH_SIZE=200
WORKER_BLOCK_MS=2000

# ---- Web (Next.js) ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
# Same dev token as above — used by the demo UI for quick auth
NEXT_PUBLIC_DEV_BEARER=dev-token-acme

# ---- Telemetry ----------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
