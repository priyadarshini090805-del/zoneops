{
  "name": "@zoneops/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "migrate:create": "tsx src/migrate.ts --create",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zoneops/config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
